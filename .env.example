# Household install: fill both from a new Supabase Free project
# (Project URL + anon/public key). Two phones need these.
# Only these two public keys. Never put the service-role key here,
# in git, or in Worker vars.
#
# Auth Site URL and Redirect URL must match the HTTPS origin phones open
# (your workers.dev URL or your own domain). See docs/domains.md.
#
# Blank or missing values are an incomplete install — you will see
# the setup gate, not a household. Leave blank only to confirm the
# gate. There is no localStorage household fallback.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
